{
  "name": "@gitpass/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute gitpass --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute gitpass --remote --file=migrations/0001_init.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.9",
    "@gitpass/crypto": "*"
  },
  "devDependencies": {
    "wrangler": "^3.87.0",
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.6.3"
  }
}
